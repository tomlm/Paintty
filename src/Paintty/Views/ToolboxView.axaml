<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paintty.ViewModels"
             xmlns:tools="using:Paintty.Tools"
             x:Class="Paintty.Views.ToolboxView"
             x:DataType="vm:ToolboxViewModel">
    <ListBox ItemsSource="{Binding Tools}"
             SelectedItem="{Binding SelectedTool}"
             Focusable="False">
        <ListBox.ItemTemplate>
            <DataTemplate DataType="tools:ToolBase">
                <StackPanel Orientation="Horizontal" Spacing="1" ToolTip.Tip="{Binding ToolTip}">
                    <TextBlock Text="{Binding Glyph}" Width="1" />
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Hotkey}" Opacity="0.5" />
                </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
