<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paintty.ViewModels"
             xmlns:views="using:Paintty.Views"
             xmlns:skia="using:SkiaSharp"
             x:Class="Paintty.Views.PaletteView"
             x:DataType="vm:PaletteViewModel">
    <StackPanel Orientation="Horizontal" Spacing="2" Margin="1,0">
        <!-- Primary over secondary, as in Paint; click one to edit it. -->
        <Grid ColumnDefinitions="Auto,1,4,1,Auto" RowDefinitions="Auto,Auto">
            <Button Content="_Primary" Command="{Binding EditPrimaryCommand}" Padding="0" />
            <Border Grid.Column="2" Background="{Binding Primary, Converter={x:Static views:Converters.ColorToBrush}}" />
            <TextBlock Grid.Column="4" Text="{Binding Primary, Converter={x:Static views:Converters.ColorToHex}}" />
            <Button Grid.Row="1" Content="_Secondary" Command="{Binding EditSecondaryCommand}" Padding="0" />
            <Border Grid.Row="1" Grid.Column="2" Background="{Binding Secondary, Converter={x:Static views:Converters.ColorToBrush}}" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Secondary, Converter={x:Static views:Converters.ColorToHex}}" />
        </Grid>

        <StackPanel VerticalAlignment="Center">
            <Button Content="⇅" ToolTip.Tip="Swap colours (X)" Command="{Binding SwapCommand}" Padding="0" />
            <Button Content="↺" ToolTip.Tip="Black and white" Command="{Binding ResetCommand}" Padding="0" />
        </StackPanel>

        <!-- Left click picks the primary colour, right click the secondary. -->
        <ItemsControl Name="Swatches" ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="skia:SKColor">
                    <Border Width="3" Height="1" Margin="0,0,1,0" Cursor="Hand"
                            Background="{Binding Converter={x:Static views:Converters.ColorToBrush}}"
                            ToolTip.Tip="{Binding Converter={x:Static views:Converters.ColorToHex}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
